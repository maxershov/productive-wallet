{
    "presets": [
        [
            "@babel/preset-env",
            {
                "loose": true,
                "useBuiltIns": "entry",
                "corejs": 3
            }
        ],
        "@babel/preset-react",
        "@babel/preset-typescript",
    ],
    "env": {
        "production": {
            "presets": [
                [
                    "@babel/preset-env",
                    {
                        "loose": true,
                        "useBuiltIns": "entry",
                        "corejs": 3
                    }
                ],
                "@babel/preset-typescript"
            ]
        }
    }
}